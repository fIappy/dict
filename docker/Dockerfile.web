# Flutter web frontend — build + serve image.
#
# This image is the single entry point of the web deployment: nginx serves the
# bundle and proxies /api/ to the backend container, so the app uses a same-origin
# API by default (DICT_API_BASE empty -> the client falls back to the page origin).
#
# Build (from the repository root):
#   docker build -f docker/Dockerfile.web -t local-dict-web .
#
# For separated hosting (bundle on a CDN, backend elsewhere) bake the backend URL:
#   docker build -f docker/Dockerfile.web \
#     --build-arg DICT_API_BASE=http://192.168.1.10:8080 -t local-dict-web .
# It can also be overridden at runtime with ?api=http://host:port in the URL.

# syntax=docker/dockerfile:1

# ---------------------------------------------------------------- build stage
FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /src

COPY pubspec.yaml ./
RUN flutter pub get

COPY lib ./lib
COPY assets ./assets
COPY web ./web

# Empty => the client falls back to the page origin, i.e. same-origin /api/.
ARG DICT_API_BASE=
RUN flutter build web --release --dart-define=DICT_API_BASE=${DICT_API_BASE}

# -------------------------------------------------------------- runtime stage
FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
