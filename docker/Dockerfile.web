# Flutter web frontend — build + serve image.
#
# Build (from the repository root):
#   docker build -f docker/Dockerfile.web \
#     --build-arg DICT_API_BASE=http://localhost:8080 \
#     -t local-dict-web .
#
# DICT_API_BASE is baked in as the compile-time default backend address. It can
# still be overridden at runtime by appending `?api=http://host:port` to the URL
# (the choice is persisted in browser storage).

# syntax=docker/dockerfile:1

# ---------------------------------------------------------------- build stage
FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /src

COPY pubspec.yaml ./
RUN flutter pub get

COPY lib ./lib
COPY assets ./assets
COPY web ./web

ARG DICT_API_BASE=http://localhost:8080
RUN flutter build web --release --dart-define=DICT_API_BASE=${DICT_API_BASE}

# -------------------------------------------------------------- runtime stage
FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
